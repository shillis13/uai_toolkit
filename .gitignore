*.egg
MANIFEST

# Virtualenvs
.venv/
venv/

# Test/cache/runtime
.pytest_cache/
.coverage
.coverage.*
.cache/
.DS_Store
*.log

# Project-local instance/runtime; never commit a populated instance
/ai_root/
config.toml

# Materialize sidecars — transient source snapshots of curated files for manual
# diff/merge review (tools/materialize.py). Not shipped, not committed.
*.materialized

# Vendored UAI app (uai_app/) — source is committed; deps + build outputs are
# restored on the target via `npm ci` + build, never committed.
uai_app/node_modules/
uai_app/**/node_modules/
uai_app/**/.vite/
uai_app/**/dist/
uai_app/**/out/
uai_app/**/UAI.app/
uai_app/**/*.tsbuildinfo

# Runtime scratch written by summarizer.py shadow-compare (not package data)
src/data/
**/summarizer_shadow/
*.materialized
